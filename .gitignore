# ─── Terraform ─────────────────────────────────────────────────────────────────
# Local .terraform directories
**/.terraform/

# `.tfstate` files contain sensitive state data (passwords, IP addresses, tokens)
*.tfstate
*.tfstate.*
crash.log
crash.*.log

# Terraform variable definitions containing secrets
*.tfvars
*.tfvars.json
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# CLI Configuration
.terraformrc
terraform.rc

# ─── Secrets & Environment Files ──────────────────────────────────────────────
.env
.env.local
.env.*.local
*.pem
*.key
*.crt

# ─── Kubernetes / Helm ────────────────────────────────────────────────────────
kubeconfig
*.kubeconfig
.kube/

